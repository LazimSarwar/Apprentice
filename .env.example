# Copy to .env and fill in. Never commit .env.
MODEL_API_KEY=

# Open-weights path (P3): Muse Spark Open on Fireworks. `python -m oneshot CLIP --provider fireworks`.
FIREWORKS_API_KEY=
# The Spark Open model slug on Fireworks, e.g. accounts/fireworks/models/<muse-spark-open>.
# Find it in your Fireworks model list (or GET {FIREWORKS_BASE_URL}/models).
FIREWORKS_MODEL=
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1   # override only if needed

# Second open-weights provider: Muse Spark Open on Baseten. `python -m oneshot CLIP --provider baseten`.
BASETEN_API_KEY=
# The event key only works with this slug (Baseten's docs show meta-models/muse-spark-open — don't use it).
BASETEN_MODEL=meta-models/muse-spark-open-1026
# Bound slow providers. A tracking timeout requires review rather than accepting a provisional pass.
MODEL_TIMEOUT_SECONDS=90
TRACK_TIMEOUT_SECONDS=120
TRACK_STREAM_TIMEOUT_SECONDS=45
MEDIA_TIMEOUT_SECONDS=90
RETENTION_SECONDS=86400
MAX_STORAGE_BYTES=1073741824
# On a container host, point PRIVATE_DATA_DIR at its mounted persistent volume.
# PRIVATE_DATA_DIR=/data/private
MODEL_RESERVE_USD=0.50
